/gallery/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
/gallery/review/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/eversave/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
